<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>Schimmelreiter</Authors>
    <Product>Network Overview</Product>
    <Copyright>Copyright © Schimmelreiter</Copyright>
    <RepositoryUrl>https://github.com/Schimmelreiter/network-overview</RepositoryUrl>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
